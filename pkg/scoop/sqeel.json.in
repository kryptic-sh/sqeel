{
  "version": "{VERSION}",
  "description": "Modal SQL workbench for the terminal",
  "homepage": "https://sqeel.kryptic.sh/",
  "license": "MIT",
  "architecture": {
    "64bit": {
      "url": "https://github.com/kryptic-sh/sqeel/releases/download/v{VERSION}/sqeel-v{VERSION}-x86_64-pc-windows-msvc.zip",
      "hash": "{SHA256_X86_64_WINDOWS}"
    }
  },
  "bin": "sqeel.exe",
  "checkver": {
    "github": "https://github.com/kryptic-sh/sqeel"
  },
  "autoupdate": {
    "architecture": {
      "64bit": {
        "url": "https://github.com/kryptic-sh/sqeel/releases/download/v$version/sqeel-v$version-x86_64-pc-windows-msvc.zip"
      }
    },
    "hash": {
      "url": "$url.sha256"
    }
  }
}
